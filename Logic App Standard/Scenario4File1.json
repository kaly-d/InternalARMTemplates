{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "defaultValue": "[resourceGroup().location]",
      "type": "String"
    },
    "logicappName": {
      "type": "String"
    },
    "hostingPlanName": {
      "type": "String",
      "metadata": {
        "description": "This will be the WS1 App Service Plan hosting the Logic App"
      }
    },
    "storageAccountName": {
      "type": "String",
      "metadata": {
        "description": "This will be the Storage Account hosting the Logic App"
      }
    },
    "virtualNetworkName": {
      "type": "String",
      "metadata": {
        "description": "This will the VNET that is connected to the Logic App's Outbound VNET configuration and also the Service Bus Private Endpoint"
      }
    },
    "outboundSubnetName": {
      "type": "String",
      "metadata": {
        "description": "This will the subnet that is connected to the Logic App's Outbound VNET configuration"
      }
    },
    "servicebus-SubnetName": {
      "type": "String",
      "metadata": {
        "description": "This will the subnet that is connected to the Service Bus's Private Endpoint"
      }
    },
    "privateEndpointName": {
      "defaultValue": "sb-private-endpoint",
      "type": "String",
      "metadata": {
        "description": "This is the Private Endpoint that will be linked on the Service Bus's firewall/networking section"
      }      
    },
    "serviceBus-NamespaceName": {
      "type": "String",
      "metadata": {
        "description": "This is the Service Bus Namespace your Logic App will connect to"
      }      
    },
    "serviceBusQueueName": {
      "type": "String",
      "metadata": {
        "description": "This is the name of the queue in the Service Bus Namespace your Logic App will connect to"
      }      
    },
    "userAssignedIdentityName": {
      "type": "string",
      "defaultValue": "uami",
      "metadata": {
        "description": "This will be the User-Assigned Identity that your Logic App will use to authenticate to Storage"
      }
    }
  },
  "variables": {
    "uamiResourceId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]",
    "serverFarmResourceId": "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",

    "outboundSubnetResourceId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), parameters('outboundSubnetName'))]",
    "serviceBusSubnetResourceId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), parameters('servicebus-SubnetName'))]",

    "storageScope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
    "serviceBusScope": "[resourceId('Microsoft.ServiceBus/namespaces', parameters('serviceBus-NamespaceName'))]",

    "blobUri": "[concat('https://', parameters('storageAccountName'), '.blob.core.windows.net')]",
    "queueUri": "[concat('https://', parameters('storageAccountName'), '.queue.core.windows.net')]",
    "tableUri": "[concat('https://', parameters('storageAccountName'), '.table.core.windows.net')]",

    "serviceBusFqdn": "[concat(parameters('serviceBus-NamespaceName'), '.servicebus.windows.net')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-11-01",
      "name": "[parameters('hostingPlanName')]",
      "location": "[parameters('location')]",
      "kind": "",
      "tags": {},
      "properties": {
        "name": "[parameters('hostingPlanName')]",
        "workerSize": "3",
        "workerSizeId": "3",
        "numberOfWorkers": "1",
        "maximumElasticWorkerCount": "20",
        "zoneRedundant": false
      },
      "sku": {
        "tier": "WorkflowStandard",
        "name": "WS1"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2020-07-01",
      "name": "[parameters('virtualNetworkName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "[parameters('outboundSubnetName')]",
            "properties": {
              "addressPrefix": "10.0.0.0/24",
              "serviceEndpoints": [
                {
                  "service": "Microsoft.Storage"
                }
              ],
              "delegations": [
                {
                  "name": "delegation",
                  "properties": {
                    "serviceName": "Microsoft.Web/serverfarms"
                  }
                }
              ]
            }
          },
          {
            "name": "[parameters('servicebus-SubnetName')]",
            "properties": {
              "addressPrefix": "10.0.1.0/24"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2022-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
      ],
      "tags": {},
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "defaultToOAuthAuthentication": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": true,
        "networkAcls": {
          "ipv6Rules": [],
          "resourceAccessRules": [],
          "bypass": "AzureServices",
          "virtualNetworkRules": [
            {
              "id": "[variables('outboundSubnetResourceId')]",
              "action": "Allow",
              "state": "Succeeded"
            }
          ],
          "ipRules": [],
          "defaultAction": "Deny"
        },
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2018-11-30",
      "name": "[parameters('userAssignedIdentityName')]",
      "location": "[parameters('location')]",
      "properties": {}
    },

    {
      "type": "Microsoft.ServiceBus/namespaces",
      "apiVersion": "2025-05-01-preview",
      "name": "[parameters('serviceBus-NamespaceName')]",
      "location": "[parameters('location')]",
      "tags": {},
      "sku": {
        "name": "Premium",
        "tier": "Premium",
        "capacity": 1
      },
      "properties": {
        "zoneRedundant": false,
        "minimumTlsVersion": "1.2",
        "disableLocalAuth": true,
        "publicNetworkAccess": "Disabled"
      }
    },
    {
      "type": "Microsoft.ServiceBus/namespaces/queues",
      "apiVersion": "2025-05-01-preview",
      "name": "[format('{0}/{1}', parameters('serviceBus-NamespaceName'), parameters('serviceBusQueueName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces', parameters('serviceBus-NamespaceName'))]"
      ],
      "properties": {
        "status": "Active",
        "lockDuration": "PT5M",
        "maxDeliveryCount": 10,
        "maxSizeInMegabytes": 1024,
        "requiresSession": false,
        "deadLetteringOnMessageExpiration": true,
        "defaultMessageTimeToLive": "P14D",
        "enablePartitioning": true
      }
    },

    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "privatelink.servicebus.windows.net",
      "location": "global",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('privatelink.servicebus.windows.net/{0}-link', parameters('virtualNetworkName'))]",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.servicebus.windows.net')]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
        }
      }
    },

    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2025-05-01",
      "name": "[parameters('privateEndpointName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]",
        "[resourceId('Microsoft.ServiceBus/namespaces', parameters('serviceBus-NamespaceName'))]"
      ],
      "properties": {
        "privateLinkServiceConnections": [
          {
            "name": "[parameters('privateEndpointName')]",
            "id": "[concat(resourceId('Microsoft.Network/privateEndpoints', parameters('privateEndpointName')), '/privateLinkServiceConnections/', parameters('privateEndpointName'))]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.ServiceBus/namespaces', parameters('serviceBus-NamespaceName'))]",
              "groupIds": [
                "namespace"
              ],
              "privateLinkServiceConnectionState": {
                "status": "Approved",
                "description": "Auto-Approved",
                "actionsRequired": "None"
              }
            }
          }
        ],
        "manualPrivateLinkServiceConnections": [],
        "ipVersionType": "IPv4",
        "subnet": {
          "id": "[variables('serviceBusSubnetResourceId')]"
        }
      }
    },

    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/default', parameters('privateEndpointName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', parameters('privateEndpointName'))]",
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.servicebus.windows.net')]"
      ],
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "servicebusDns",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.servicebus.windows.net')]"
            }
          }
        ]
      }
    },

    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-03-01",
      "name": "[parameters('logicappName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]"
      ],
      "tags": {},
      "kind": "functionapp,workflowapp",
      "identity": {
        "type": "SystemAssigned, UserAssigned",
        "userAssignedIdentities": {
          "[variables('uamiResourceId')]": {}
        }
      },
      "properties": {
        "name": "[parameters('logicappName')]",
        "outboundVnetRouting": {
          "allTraffic": false,
          "applicationTraffic": true,
          "contentShareTraffic": true,
          "imagePullTraffic": false,
          "backupRestoreTraffic": false
        },
        "siteConfig": {
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~22"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "AzureWebJobsStorage__blobServiceUri",
              "value": "[variables('blobUri')]"
            },
            {
              "name": "AzureWebJobsStorage__queueServiceUri",
              "value": "[variables('queueUri')]"
            },
            {
              "name": "AzureWebJobsStorage__tableServiceUri",
              "value": "[variables('tableUri')]"
            },
            {
              "name": "AzureWebJobsStorage__managedIdentityResourceId",
              "value": "[variables('uamiResourceId')]"
            },
            {
              "name": "AzureFunctionsJobHost__extensionBundle__id",
              "value": "Microsoft.Azure.Functions.ExtensionBundle.Workflows"
            },
            {
              "name": "AzureFunctionsJobHost__extensionBundle__version",
              "value": "[1.*, 2.0.0)"
            },
            {
              "name": "APP_KIND",
              "value": "workflowApp"
            },
            {
              "name": "serviceBus_fullyQualifiedNamespace",
              "value": "[variables('serviceBusFqdn')]",
              "slotSetting": false
            },
            {
              "name": "ServiceBusQueueName",
              "value": "[parameters('serviceBusQueueName')]",
              "slotSetting": false
            },
            {
              "name": "FUNCTIONS_INPROC_NET8_ENABLED",
              "value": 1
            },
            {
              "name": "LOGIC_APPS_POWERSHELL_VERSION",
              "value": 7.4
            }
          ],
          "cors": {},
          "use32BitWorkerProcess": false,
          "ftpsState": "FtpsOnly",
          "vnetPrivatePortsCount": 2,
          "netFrameworkVersion": "v8.0"
        },
        "clientAffinityEnabled": false,
        "virtualNetworkSubnetId": "[variables('outboundSubnetResourceId')]",
        "functionsRuntimeAdminIsolationEnabled": false,
        "autoGeneratedDomainNameLabelScope": "TenantReuse",
        "publicNetworkAccess": "Enabled",
        "vnetContentShareEnabled": true,
        "vnetRouteAllEnabled": true,
        "httpsOnly": true,
        "serverFarmId": "[variables('serverFarmResourceId')]"
      },
      "resources": [
        {
          "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
          "apiVersion": "2022-09-01",
          "name": "[concat(parameters('logicappName'), '/scm')]",
          "dependsOn": [
            "[resourceId('Microsoft.Web/sites', parameters('logicappName'))]"
          ],
          "properties": {
            "allow": false
          }
        },
        {
          "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
          "apiVersion": "2022-09-01",
          "name": "[concat(parameters('logicappName'), '/ftp')]",
          "dependsOn": [
            "[resourceId('Microsoft.Web/sites', parameters('logicappName'))]"
          ],
          "properties": {
            "allow": false
          }
        }
      ]
    },

    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('serviceBusScope'), resourceId('Microsoft.Web/sites', parameters('logicappName')), 'SBDataOwner')]",
      "scope": "[variables('serviceBusScope')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('logicappName'))]",
        "[resourceId('Microsoft.ServiceBus/namespaces', parameters('serviceBus-NamespaceName'))]"
      ],
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('logicappName')), '2022-03-01', 'Full').identity.principalId]",
        "roleDefinitionId": "[concat(subscription().id, '/providers/Microsoft.Authorization/roleDefinitions/090c5cfd-751d-490a-894a-3ce6f1109419')]",
        "principalType": "ServicePrincipal"
      }
    },

    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, resourceGroup().id, parameters('logicappName'), '17d1049b-9a84-46fb-8f53-869881c3d3ab')]",
      "scope": "[variables('storageScope')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '17d1049b-9a84-46fb-8f53-869881c3d3ab')]",
        "principalId": "[reference(variables('uamiResourceId'), '2018-11-30').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, resourceGroup().id, parameters('logicappName'), 'b7e6dc6d-f1e8-4753-8033-0f276bb0955b')]",
      "scope": "[variables('storageScope')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b7e6dc6d-f1e8-4753-8033-0f276bb0955b')]",
        "principalId": "[reference(variables('uamiResourceId'), '2018-11-30').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, resourceGroup().id, parameters('logicappName'), '974c5e8b-45b9-4653-ba55-5f855dd0fb88')]",
      "scope": "[variables('storageScope')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '974c5e8b-45b9-4653-ba55-5f855dd0fb88')]",
        "principalId": "[reference(variables('uamiResourceId'), '2018-11-30').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, resourceGroup().id, parameters('logicappName'), '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3')]",
      "scope": "[variables('storageScope')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3')]",
        "principalId": "[reference(variables('uamiResourceId'), '2018-11-30').principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ]
}
